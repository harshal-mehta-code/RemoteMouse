{
  "productName": "RemoteMouse",
  "version": "2.4.0",
  "identifier": "com.remotemouse.app",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../src-shared/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RemoteMouse",
        "width": 300,
        "height": 500,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "url": "tray-popover.html",
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
    },

  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../src-shared/public": "public"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
