{
  "productName": "RemoteMouse",
  "version": "2.0.0",
  "identifier": "com.remotemouse.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RemoteMouse",
        "width": 300,
        "height": 500,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "devtools": true,
        "url": "tray-popover.html",
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
    },

  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../public/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
