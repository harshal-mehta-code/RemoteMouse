{
  "name": "remotemouse",
  "productName": "RemoteMouse",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:frontend": "esbuild src-shared/public/client.ts --bundle --outfile=src-shared/public/client.js --platform=browser",
    "tauri:dev": "npm run build:frontend && tauri dev",
    "tauri:build": "npm run build:frontend && tauri build",
    "electron:dev": "node src-electron/build.js && electron dist/main.js",
    "electron:make": "node src-electron/build.js && electron-forge make",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "RemoteMouse",
        "asar": true,
        "icon": "iconTemplate",
        "ignore": [
          "^/\\.git$",
          "^/src-tauri$",
          "^/src-electron$",
          "^/src-shared$",
          "^/assets$",
          "^/README\\.md$",
          "^/package-lock\\.json$"
        ]
      },
      "rebuildConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "name": "RemoteMouse"
          }
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {}
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-auto-unpack-natives",
          "config": {}
        }
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "menubar": "^5.2.3",
    "qrcode": "^1.5.4",
    "robotjs": "^0.7.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "mouse-macos": "^0.2.1",
    "node-mac-permissions": "^2.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron/rebuild": "^4.0.4",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "electron": "^42.1.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
