{
  "name": "remotemouse",
  "productName": "RemoteMouse",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "start": "node build.js && electron dist/main.js",
    "build": "node build.js",
    "package": "node build.js && electron-forge package",
    "make": "node build.js && electron-forge make",
    "dev": "node build.js && electron dist/main.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "RemoteMouse",
        "asar": true,
        "icon": "iconTemplate",
        "ignore": [
          "^/\\.git$",
          "^/src-tauri$",
          "^/public$",
          "^/server$",
          "^/main\\.js$",
          "^/build\\.js$",
          "^/README\\.md$",
          "^/tray-popover\\.html$"
        ]
      },
      "rebuildConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "name": "RemoteMouse"
          }
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {}
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-auto-unpack-natives",
          "config": {}
        }
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "menubar": "^9.5.2",
    "qrcode": "^1.5.4",
    "robotjs": "^0.7.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "mouse-macos": "^0.2.1",
    "node-mac-permissions": "^2.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron/rebuild": "^4.0.4",
    "electron": "^34.5.8",
    "esbuild": "^0.28.0"
  }
}
